{
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shadow-panda/styled-system/*": ["@shadow-panda/styled-system/*"]
    }
  },
  "exclude": ["node_modules"]
}
